# Copy this file to .env and adjust as needed for local development.
# In docker-compose.yml, DATABASE_URL/REDIS_URL are already set to point at
# the "postgres" and "redis" service names, so .env is mainly needed when
# running the API directly on the host (outside Docker).

APP_NAME=ResearchOS API
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://researchos:researchos_dev@localhost:5432/researchos
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

DEFAULT_RATE_LIMIT_PER_MINUTE=300
SEARCH_RATE_LIMIT_PER_MINUTE=20

STORAGE_ROOT=./storage

MAX_FAILED_LOGIN_ATTEMPTS=5
